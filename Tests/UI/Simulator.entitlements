<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- CI simulator identity only. Never use this file for device or distribution signing. -->
<plist version="1.0"><dict>
    <key>application-identifier</key><string>SUPPERTEST.$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>keychain-access-groups</key><array><string>SUPPERTEST.$(PRODUCT_BUNDLE_IDENTIFIER)</string></array>
    <key>get-task-allow</key><true/>
</dict></plist>
