DEFINE SCHEMA

    RECORD TYPE CD_GroceryItem (
        CD_categoryOverride                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_categoryOverride_ckAsset          ASSET,
        CD_entityName                        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_isChecked                         INT64 QUERYABLE SORTABLE,
        CD_library                           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt                       BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset               ASSET,
        CD_name                              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset                      ASSET,
        CD_operationKey                      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_operationKey_ckAsset              ASSET,
        CD_order                             INT64 QUERYABLE SORTABLE,
        CD_quantity                          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_quantity_ckAsset                  ASSET,
        CD_removed                           INT64 QUERYABLE SORTABLE,
        CD_sourceRecipeIDsJSON               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sourceRecipeIDsJSON_ckAsset       ASSET,
        CD_unit                              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_unit_ckAsset                      ASSET,
        "___createTime"                      TIMESTAMP,
        "___createdBy"                       REFERENCE,
        "___etag"                            STRING,
        "___modTime"                         TIMESTAMP,
        "___modifiedBy"                      REFERENCE,
        "___recordID"                        REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_HouseholdMember (
        CD_accountID                         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_accountID_ckAsset                 ASSET,
        CD_entityName                        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id_ckAsset                        ASSET,
        CD_library                           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt                       BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset               ASSET,
        CD_name                              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset                      ASSET,
        CD_updatedAt                         TIMESTAMP QUERYABLE SORTABLE,
        "___createTime"                      TIMESTAMP,
        "___createdBy"                       REFERENCE,
        "___etag"                            STRING,
        "___modTime"                         TIMESTAMP,
        "___modifiedBy"                      REFERENCE,
        "___recordID"                        REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Ingredient (
        CD_categoryOverride                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_categoryOverride_ckAsset          ASSET,
        CD_entityName                        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_groupName                         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_groupName_ckAsset                 ASSET,
        CD_id                                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt                       BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset               ASSET,
        CD_name                              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset                      ASSET,
        CD_order                             INT64 QUERYABLE SORTABLE,
        CD_quantity                          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_quantity_ckAsset                  ASSET,
        CD_recipe                            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_unit                              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_unit_ckAsset                      ASSET,
        "___createTime"                      TIMESTAMP,
        "___createdBy"                       REFERENCE,
        "___etag"                            STRING,
        "___modTime"                         TIMESTAMP,
        "___modifiedBy"                      REFERENCE,
        "___recordID"                        REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Reaction (
        CD_emoji                             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_emoji_ckAsset                     ASSET,
        CD_entityName                        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt                       BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset               ASSET,
        CD_personID                          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_personID_ckAsset                  ASSET,
        CD_recipe                            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_updatedAt                         TIMESTAMP QUERYABLE SORTABLE,
        "___createTime"                      TIMESTAMP,
        "___createdBy"                       REFERENCE,
        "___etag"                            STRING,
        "___modTime"                         TIMESTAMP,
        "___modifiedBy"                      REFERENCE,
        "___recordID"                        REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Recipe (
        CD_collectionIDsJSON                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_collectionIDsJSON_ckAsset         ASSET,
        CD_createdAt                         TIMESTAMP QUERYABLE SORTABLE,
        CD_durationMinutes                   INT64 QUERYABLE SORTABLE,
        CD_entityName                        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_imageData                         BYTES QUERYABLE SORTABLE,
        CD_imageData_ckAsset                 ASSET,
        CD_library                           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt                       BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset               ASSET,
        CD_notes                             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_notes_ckAsset                     ASSET,
        CD_servings                          INT64 QUERYABLE SORTABLE,
        CD_sourceURL                         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sourceURL_ckAsset                 ASSET,
        CD_tagsJSON                          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_tagsJSON_ckAsset                  ASSET,
        CD_title                             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_title_ckAsset                     ASSET,
        "___createTime"                      TIMESTAMP,
        "___createdBy"                       REFERENCE,
        "___etag"                            STRING,
        "___modTime"                         TIMESTAMP,
        "___modifiedBy"                      REFERENCE,
        "___recordID"                        REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_RecipeCollection (
        CD_entityName                        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_isOnHome                          INT64 QUERYABLE SORTABLE,
        CD_library                           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt                       BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset               ASSET,
        CD_name                              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset                      ASSET,
        CD_order                             INT64 QUERYABLE SORTABLE,
        CD_removed                           INT64 QUERYABLE SORTABLE,
        "___createTime"                      TIMESTAMP,
        "___createdBy"                       REFERENCE,
        "___etag"                            STRING,
        "___modTime"                         TIMESTAMP,
        "___modifiedBy"                      REFERENCE,
        "___recordID"                        REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_RecipeStep (
        CD_entityName                        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt                       BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset               ASSET,
        CD_order                             INT64 QUERYABLE SORTABLE,
        CD_recipe                            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_text                              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_text_ckAsset                      ASSET,
        "___createTime"                      TIMESTAMP,
        "___createdBy"                       REFERENCE,
        "___etag"                            STRING,
        "___modTime"                         TIMESTAMP,
        "___modifiedBy"                      REFERENCE,
        "___recordID"                        REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_SupperLibrary (
        CD_createdAt                         TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName                        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt                       BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset               ASSET,
        CD_name                              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset                      ASSET,
        "___createTime"                      TIMESTAMP,
        "___createdBy"                       REFERENCE,
        "___etag"                            STRING,
        "___modTime"                         TIMESTAMP,
        "___modifiedBy"                      REFERENCE,
        "___recordID"                        REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime"                      TIMESTAMP,
        "___createdBy"                       REFERENCE,
        "___etag"                            STRING,
        "___modTime"                         TIMESTAMP,
        "___modifiedBy"                      REFERENCE,
        "___recordID"                        REFERENCE,
        roles                                LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

    RECORD TYPE "cloudkit.share" (
        "___createTime"                      TIMESTAMP,
        "___createdBy"                       REFERENCE,
        "___etag"                            STRING,
        "___modTime"                         TIMESTAMP,
        "___modifiedBy"                      REFERENCE,
        "___recordID"                        REFERENCE,
        "cloudkit.thumbnailImageData"        BYTES,
        "cloudkit.title"                     STRING,
        "cloudkit.type"                      STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );
